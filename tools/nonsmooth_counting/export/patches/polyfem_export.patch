+
+	long BarrierContactNonsmoothTerm::cl_write_elem(const std::vector<int> &ids, const Eigen::VectorXd &xfull, const std::string &file, const long step, const long outer, const long point) const
+	{
+		if (!elastic_ || ids.empty())
+			return -1;
+		std::vector<double> B, lam, mu, da, u;
+		if (!elastic_->cl_elements(ids, xfull, B, lam, mu, da, u))
+			return -1;
+		polysolve::cl::BinOut o(file);
+		if (!o.ok())
+			return -1;
+		o.magic("CLELM001");
+		o.i64((long long)ids.size());
+		o.i64(step);
+		o.i64(outer);
+		o.i64(point);
+		o.i32v(ids.data(), ids.size());
+		o.f64v(B.data(), B.size());
+		o.f64v(lam.data(), lam.size());
+		o.f64v(mu.data(), mu.size());
+		o.f64v(da.data(), da.size());
+		o.f64v(u.data(), u.size());
+		return long(ids.size());
+	}
+
+	long BarrierContactNonsmoothTerm::cl_export_elem(const Eigen::VectorXd &xfull, const std::string &file, const long step, const long outer, const long point)
+	{
+		if (!lift_exact())
+			return -1;
+		return cl_write_elem(lift_->ids, xfull, file, step, outer, point);
+	}
+
+	bool BarrierContactNonsmoothTerm::cl_export_mesh(const std::string &file) const
+	{
+		const ipc::CollisionMesh &m = mesh_;
+		polysolve::cl::BinOut o(file);
+		if (!o.ok())
+			return false;
+		const Eigen::MatrixXd &rest = m.rest_positions();
+		const auto &Ed = m.edges();
+		const auto &Fd = m.faces();
+		o.magic("CLCMSH01");
+		o.i64(rest.rows());
+		o.i64(Ed.rows());
+		o.i64(Fd.rows());
+		o.i64(3);
+		for (Eigen::Index i = 0; i < rest.rows(); ++i)
+			for (int d = 0; d < 3; ++d)
+				o.f64(d < rest.cols() ? rest(i, d) : 0.0);
+		for (Eigen::Index i = 0; i < Ed.rows(); ++i)
+			for (int d = 0; d < 2; ++d)
+				o.i32(int(Ed(i, d)));
+		for (Eigen::Index i = 0; i < Fd.rows(); ++i)
+			for (int d = 0; d < 3; ++d)
+				o.i32(int(Fd(i, d)));
 		return true;
 	}
 
