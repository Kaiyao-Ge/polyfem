     };
diff -ruN ps_orig/src/polysolve/nonlinear/ClFact.hpp ps/src/polysolve/nonlinear/ClFact.hpp
--- ps_orig/src/polysolve/nonlinear/ClFact.hpp	1969-12-31 19:00:00.000000000 -0500
+++ ps/src/polysolve/nonlinear/ClFact.hpp	2026-11-23 15:26:41.728053210 -0500
@@ -0,0 +1,77 @@
+#pragma once
+
+// EXPORT BUILD ONLY: the row and the replay export (CLFACT01) of one factorization; see polysolve/ClExport.hpp.
+
+#include <polysolve/ClExport.hpp>
+#include <polysolve/ClTime.hpp>
+#include <polysolve/linear/Solver.hpp>
+
+namespace polysolve::cl
+{
+    /// the replay export of a factorization (CLFACT01): the matrix as handed to the solver
+    inline void export_fact(const StiffnessMatrix &H, const bool ok, const bool analyzed, const long minor, const double perm_minor, const long long factor_ns, const std::string &kind)
+    {
+        Export &ex = exporter();
+        ExportItem *it = ex.offer(ok ? "fact" : "factfail");
+        if (it == nullptr)
+            return;
+        std::string path;
+        ExportSub &s = ex.sub(*it, "fact", path);
+        const Ctx &c = ctx();
+        s.kind = kind;
+        s.step = c.step;
+        s.outer = c.outer;
+        s.point = c.point;
+        s.success = ok ? 1 : 0;
+        s.minor = minor;
+        s.n = long(H.rows());
+        s.nnz = long(H.nonZeros());
+        s.extra = analyzed ? "pattern_changed" : "-";
+        s.solver_ns = factor_ns;
+        StiffnessMatrix Hc = H;
+        Hc.makeCompressed();
+        BinOut o(path);
+        if (!o.ok())
+            return;
+        o.magic("CLFACT01");
+        o.i64(Hc.rows());
+        o.i64(Hc.nonZeros());
+        o.i64(ok ? (long long)Hc.rows() : (long long)minor);
+        o.i64(ok ? 1 : 0);
+        o.i64(ok ? -1 : (long long)perm_minor);
+        o.i32v(Hc.outerIndexPtr(), size_t(Hc.cols()) + 1);
+        o.i32v(Hc.innerIndexPtr(), size_t(Hc.nonZeros()));
+        o.f64v(Hc.valuePtr(), size_t(Hc.nonZeros()));
+    }
+
+    /// the row of one factorization (called after the numeric factorization with the solver that did it). kind: primary, retry_proj, repair, chain
+    inline void fact_row(const linear::Solver &lin, const StiffnessMatrix &H, const bool analyzed, const bool ok, const long long analyze_ns, const long long factor_ns, const std::string &kind)
+    {
+        Scope cl_hook("X.hook");
+        Ctx &c = ctx();
+        double fl = 0, lnz = 0, minor = 0, nn = 0, fl_done = -1, perm_minor = -1;
+        const bool have = lin.factor_stats(fl, lnz, minor, nn, fl_done, perm_minor);
+        json r = {{"t", "fact"}, {"step", c.step}, {"outer", c.outer}, {"seq", c.fact_seq++}, {"kind", kind}, {"pattern_changed", analyzed}, {"n", long(H.rows())}, {"nnz", long(H.nonZeros())},
+                  {"success", ok}, {"analyze_cpu_ns", analyze_ns}, {"factor_cpu_ns", factor_ns}};
+        if (have)
+        {
+            r["fl"] = fl;
+            r["lnz"] = lnz;
+            r["minor"] = long(minor);
+            r["fl_done"] = ok ? fl : fl_done;
+        }
+        else
+        {
+            r["fl"] = -1;
+            r["lnz"] = -1;
+            r["minor"] = ok ? long(H.rows()) : -1L;
+            r["fl_done"] = -1;
+        }
+        c.last_lnz = lnz;
+        put(r);
+        if (xon() && (!ok || (kind == "primary" && c.fact_in_outer == 0)))
+            export_fact(H, ok, analyzed, r["minor"].get<long>(), perm_minor, factor_ns, kind);
+        if (ok || kind == "primary")
+            ++c.fact_in_outer;
+    }
