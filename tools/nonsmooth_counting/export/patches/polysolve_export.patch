         virtual bool failure_pivot(long &index) const { return false; }
 
+        /// @brief EXPORT BUILD: statistics of the last numeric factorization of a CHOLMOD solver: the flop count and the nonzeros of L of its last
+        /// symbolic analysis, the column at which the numeric factorization stopped (n on success), n, the flops done before the stop (sum over the
+        /// columns before `minor` of ColCount^2; -1 if CHOLMOD does not give the column counts) and the unknown at which it stopped; false if the solver does not report them
+        virtual bool factor_stats(double &flops, double &lnz, double &minor, double &n, double &flops_done, double &perm_minor) const { return false; }
+
         /// @brief Name of the solver type (for debugging purposes)
