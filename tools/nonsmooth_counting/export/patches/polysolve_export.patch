diff -ruN ps_orig/src/polysolve/ClExport.hpp ps/src/polysolve/ClExport.hpp
--- ps_orig/src/polysolve/ClExport.hpp	1969-12-31 19:00:00.000000000 -0500
+++ ps/src/polysolve/ClExport.hpp	2026-11-23 13:00:34.866354669 -0500
@@ -0,0 +1,298 @@
+#pragma once
+
+// EXPORT BUILD ONLY (tools/nonsmooth_counting/export): counting and export hooks of the external counting tool
+// (tools/nonsmooth_counting/counting/README.md). Not part of the production code.
+//
+// Switches (environment variables; unset: nothing is written, nothing is computed beyond one branch on a static flag):
+//   POLYFEM_CL_COUNTS=<dir>   <dir>/cl_counts.jsonl: one JSON row per factorization ("fact"), outer iteration ("outer"), accepted point ("point"),
+//                             CCD or collision-set call ("ccd"), and solve ("solve"); formats as joint/cl/interfaces.md section 1, see README.md
+//   POLYFEM_CL_EXPORT=<dir>   <dir>/index.tsv and the .bin files of joint/cl/interfaces.md section 2 (fact, blocks, elem, surf, ccdmesh) plus tiq
+//                             (the narrow-phase queries that the solver handed to Tight Inclusion, CLTIQ001)
+// Neither switch changes a number of the solve.
+//
+// The selection of the exported items is made on line with files that are deleted again when an item drops out, so that the disk holds at most the
+// selected set (plus one rolling "last" item per group):
+//   fact:    the first primary factorization of every outer, thinned to 20 (uniform, the stride doubles when the list is full); every failed factorization (thinned to 4)
+//   blocks / elem: of the accepted points 8 uniform (stride doubling, the first kept) + the last point (a rolling slot) + the 2 points with the most new blocks
+//   surf:    CCD calls 12 uniform + the last; collision-set builds 8 uniform + the last; the TI queries (tiq) belong to the item of their CCD call
+//   ccdmesh: once.
+// The same decision serves all files of a point (blocks and elem) or of a call (surf and tiq). index.tsv is written when the process ends.
+
+#include <polysolve/Types.hpp>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <list>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace polysolve::cl
+{
+    struct Ctx
+    {
+        bool on = false;
+        std::string dir;
+        std::FILE *f = nullptr;
+        // context of the rows (set by the strategy, read by the problem)
+        long step = 0;  ///< minimize (solve) counter, 1-based: the index of the entry of solver_info
+        long outer = 0; ///< iteration of this minimize that the strategy has been asked for, 1-based
+        long point = 0; ///< global accepted-point counter (every build of the reduced matrix)
+        const int *inner_ptr = nullptr; ///< accepted inner steps of the running path
+        bool blind = false;
+        long ccd_seq = 0, fact_seq = 0;
+        std::string fact_kind = "other";
+        long fact_in_outer = 0;
+        bool chain_analyzed = false; ///< the last Newton::analyze_pattern did the symbolic analysis
+        long long chain_an_ns = 0;
+        double last_lnz = -1; ///< lnz of the last factorization row
+        Ctx()
+        {
+            const char *d = std::getenv("POLYFEM_CL_COUNTS");
+            if (d == nullptr || d[0] == '\0')
+                return;
+            dir = d;
+            std::filesystem::create_directories(dir);
+            f = std::fopen((dir + "/cl_counts.jsonl").c_str(), "wb");
+            on = f != nullptr;
+        }
+        ~Ctx()
+        {
+            if (f != nullptr)
+                std::fclose(f);
+        }
+    };
+
+    inline Ctx &ctx()
+    {
+        static Ctx c;
+        return c;
+    }
+
+    inline bool on() { return ctx().on; }
+
+    inline void put(const json &j)
+    {
+        Ctx &c = ctx();
+        if (!c.on)
+            return;
+        const std::string s = j.dump() + "\n";
+        std::fwrite(s.data(), 1, s.size(), c.f);
+    }
+
+    /// thread CPU time, nanoseconds
+    inline long long cpu_ns()
+    {
+        timespec ts;
+        clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
+        return (long long)ts.tv_sec * 1000000000LL + (long long)ts.tv_nsec;
+    }
+
+    // ------------------------------------------------------------------------------------------------------------------ the replay exports
+    struct ExportSub
+    {
+        std::string type, kind = "-", file, id;
+        long step = -1, outer = -1, point = -1, success = -1, minor = -1, n = -1, nnz = -1;
+        long long solver_ns = 0;
+        std::string extra = "-";
+    };
+    struct ExportItem
+    {
+        long idx = 0;
+        int roles = 0; ///< 1 uniform, 2 last, 4 top (new blocks)
+        long newb = 0;
+        long seq = 0;
+        std::vector<ExportSub> subs;
+    };
+    struct ExportGroup
+    {
+        size_t cap = 8, ntop = 0;
+        bool last = true;
+        long stride = 1, counter = 0;
+        std::list<ExportItem> items;
+    };
+    struct Export
+    {
+        bool on = false;
+        std::string dir;
+        long seq = 0;
+        std::map<std::string, ExportGroup> groups;
+        bool mesh_done = false;
+        Export()
+        {
+            const char *d = std::getenv("POLYFEM_CL_EXPORT");
+            if (d == nullptr || d[0] == '\0')
+                return;
+            dir = d;
+            std::filesystem::create_directories(dir);
+            on = true;
+            groups["fact"].cap = 20;
+            groups["fact"].last = false;
+            groups["factfail"].cap = 4;
+            groups["factfail"].last = false;
+            groups["blocks"].cap = 8;
+            groups["blocks"].ntop = 2;
+            groups["surf_ccd"].cap = 12;
+            groups["surf_coll"].cap = 8;
+        }
+        static void drop_files(const std::string &dir, ExportItem &it)
+        {
+            for (const ExportSub &s : it.subs)
+            {
+                std::error_code ec;
+                std::filesystem::remove(dir + "/" + s.file, ec);
+            }
+        }
+        void release(ExportGroup &G, std::list<ExportItem>::iterator it, const int role)
+        {
+            it->roles &= ~role;
+            if (it->roles == 0)
+            {
+                drop_files(dir, *it);
+                G.items.erase(it);
+            }
+        }
+        /// the decision for the next candidate of a group; nullptr: not selected. newb: the number of new blocks (ranks the top slots). The caller adds the sub files (sub()).
+        ExportItem *offer(const std::string &group, const long newb = 0)
+        {
+            if (!on)
+                return nullptr;
+            ExportGroup &G = groups[group];
+            const long i = G.counter++;
+            int roles = 0;
+            if (i % G.stride == 0)
+                roles |= 1;
+            if (G.ntop > 0 && newb > 0)
+            {
+                size_t nt = 0;
+                std::list<ExportItem>::iterator mn = G.items.end();
+                for (auto it = G.items.begin(); it != G.items.end(); ++it)
+                    if (it->roles & 4)
+                    {
+                        ++nt;
+                        if (mn == G.items.end() || it->newb < mn->newb)
+                            mn = it;
+                    }
+                if (nt < G.ntop)
+                    roles |= 4;
+                else if (newb > mn->newb)
+                {
+                    release(G, mn, 4);
+                    roles |= 4;
+                }
+            }
+            if (G.last)
+            {
+                for (auto it = G.items.begin(); it != G.items.end();)
+                {
+                    auto nx = std::next(it);
+                    if (it->roles & 2)
+                        release(G, it, 2);
+                    it = nx;
+                }
+                if (roles == 0)
+                    roles |= 2;
+            }
+            if (roles == 0)
+                return nullptr;
+            ExportItem item;
+            item.idx = i;
+            item.roles = roles;
+            item.newb = newb;
+            item.seq = seq++;
+            G.items.push_back(item);
+            size_t nu = 0;
+            for (const ExportItem &x : G.items)
+                nu += (x.roles & 1) ? 1 : 0;
+            if (nu > G.cap)
+            {
+                G.stride *= 2;
+                for (auto it = G.items.begin(); it != G.items.end();)
+                {
+                    auto nx = std::next(it);
+                    if ((it->roles & 1) && it->idx % G.stride != 0)
+                        release(G, it, 1);
+                    it = nx;
+                }
+            }
+            for (auto it = G.items.begin(); it != G.items.end(); ++it)
+                if (it->seq == item.seq)
+                    return &*it;
+            return nullptr;
+        }
+        /// adds a file to an item, names it <type>_<seq>.bin and returns the sub (the caller fills the meta data) and the path
+        ExportSub &sub(ExportItem &it, const std::string &type, std::string &path)
+        {
+            ExportSub s;
+            s.type = type;
+            s.id = type + "_" + std::to_string(it.seq);
+            s.file = s.id + ".bin";
+            it.subs.push_back(s);
+            path = dir + "/" + s.file;
+            return it.subs.back();
+        }
+        ~Export()
+        {
+            if (!on)
+                return;
+            std::vector<std::pair<long, const ExportSub *>> ord;
+            for (const auto &[name, G] : groups)
+                for (const ExportItem &it : G.items)
+                    for (const ExportSub &s : it.subs)
+                        ord.emplace_back(it.seq * 8 + long(&s - &it.subs[0]), &s);
+            ExportSub m;
+            if (mesh_done)
+            {
+                m.type = "ccdmesh";
+                m.id = "ccdmesh";
+                m.file = "ccdmesh.bin";
+                ord.emplace_back(-1, &m);
+            }
+            std::sort(ord.begin(), ord.end(), [](const auto &a, const auto &b) { return a.first < b.first; });
+            std::ofstream f(dir + "/index.tsv");
+            f << "id\tfile\ttype\tstep\touter\tpoint\tkind\tsuccess\tminor\tn\tnnz\textra\tsolver_cpu_ns\n";
+            for (const auto &[o, s] : ord)
+                f << s->id << '\t' << s->file << '\t' << s->type << '\t' << s->step << '\t' << s->outer << '\t' << s->point << '\t' << s->kind << '\t' << s->success << '\t' << s->minor << '\t' << s->n << '\t' << s->nnz << '\t' << s->extra << '\t' << s->solver_ns << '\n';
+        }
+    };
+    inline Export &exporter()
+    {
+        static Export e;
+        return e;
+    }
+    inline bool xon() { return exporter().on; }
+    /// either switch is set
+    inline bool any() { return on() || xon(); }
+
+    /// one narrow-phase query that the solver handed to Tight Inclusion (CLTIQ001): the family (0 vertex-vertex, 1 edge-vertex, 2 edge-edge, 3 face-vertex), the
+    /// positions of its 2 / 3 / 4 / 4 vertices at the start (xa) and the end (xb) of the segment (3 numbers each, in the order of the stencil) and the tmax it was given
+    struct TiQuery
+    {
+        int family = 0, nv = 0;
+        double tmax = 1;
+        double xa[12], xb[12];
+    };
+
+    /// binary writer helpers (little endian, as on the host)
+    struct BinOut
+    {
+        std::FILE *f = nullptr;
+        explicit BinOut(const std::string &path) : f(std::fopen(path.c_str(), "wb")) {}
+        ~BinOut()
+        {
+            if (f != nullptr)
+                std::fclose(f);
+        }
+        bool ok() const { return f != nullptr; }
+        void magic(const char *m) { std::fwrite(m, 1, 8, f); }
+        void i64(const long long v) { std::fwrite(&v, sizeof v, 1, f); }
+        void i32(const int v) { std::fwrite(&v, sizeof v, 1, f); }
+        void f64(const double v) { std::fwrite(&v, sizeof v, 1, f); }
+        void i32v(const int *p, const size_t n) { std::fwrite(p, sizeof(int), n, f); }
+        void f64v(const double *p, const size_t n) { std::fwrite(p, sizeof(double), n, f); }
+    };
+} // namespace polysolve::cl
diff -ruN ps_orig/src/polysolve/ClTime.hpp ps/src/polysolve/ClTime.hpp
--- ps_orig/src/polysolve/ClTime.hpp	1969-12-31 19:00:00.000000000 -0500
+++ ps/src/polysolve/ClTime.hpp	2026-11-23 15:34:01.300352249 -0500
@@ -0,0 +1,133 @@
+#pragma once
+
+// EXPORT BUILD ONLY (tools/nonsmooth_counting/export): exclusive thread-CPU timers by category, to see which part of a solve is priced by which cost item
+// (tools/nonsmooth_counting/counting/README.md) and to check the estimate against a measurement. Header only, enabled by POLYFEM_CL_COUNTS.
+//
+// A Scope("name", units) measures the thread CPU time between its construction and destruction, minus the time of the scopes nested inside it (exclusive time), and adds it
+// to the category "name" together with the number of calls and the work units of the calls. The measurement is only a check of the unit prices; the prices themselves come from
+// isolated replays and micro-benchmarks (counting/replay, and the bench epilogue of the export build).
+// Per minimize (one solve) the strategy writes one row {"t":"cats","step","total_cpu_ns","cats":{name:{ns,calls,units}}} and clears the table.
+
+#include <polysolve/ClExport.hpp>
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace polysolve::cl
+{
+    struct CatStat
+    {
+        double ns = 0, units = 0;
+        long calls = 0;
+    };
+
+    struct Timers
+    {
+        struct Frame
+        {
+            long long t0 = 0, child = 0;
+            const char *name = nullptr;
+            std::string dyn; ///< the name when it was built at run time
+            double units = 0;
+        };
+        std::map<std::string, CatStat> table;
+        std::vector<Frame> stack;
+        bool on = false;
+        long long solve_t0 = 0;
+        Timers() { on = std::getenv("POLYFEM_CL_COUNTS") != nullptr && std::getenv("POLYFEM_CL_COUNTS")[0] != '\0' && std::getenv("POLYFEM_CL_NOTIMERS") == nullptr; }
+    };
+
+    inline Timers &timers()
+    {
+        static Timers t;
+        return t;
+    }
+
+    /// the projection setting of the Hessian assembly in progress (the categories of the projected and the raw assembly are priced apart)
+    inline bool &proj_flag()
+    {
+        static bool p = false;
+        return p;
+    }
+
+    struct Scope
+    {
+        bool active = false;
+        explicit Scope(const char *name, const double units = 0)
+        {
+            Timers &T = timers();
+            if (!T.on)
+                return;
+            active = true;
+            T.stack.emplace_back();
+            Timers::Frame &f = T.stack.back();
+            f.name = name;
+            f.units = units;
+            f.t0 = cpu_ns();
+        }
+        Scope(const std::string &name, const double units)
+        {
+            Timers &T = timers();
+            if (!T.on)
+                return;
+            active = true;
+            T.stack.emplace_back();
+            Timers::Frame &f = T.stack.back();
+            f.dyn = name;
+            f.units = units;
+            f.t0 = cpu_ns();
+        }
+        /// work units that are only known inside the scope
+        void add_units(const double u)
+        {
+            if (active)
+                timers().stack.back().units += u;
+        }
+        ~Scope()
+        {
+            if (!active)
+                return;
+            Timers &T = timers();
+            const long long now = cpu_ns();
+            Timers::Frame f = std::move(T.stack.back());
+            T.stack.pop_back();
+            const long long total = now - f.t0;
+            CatStat &c = T.table[f.name != nullptr ? std::string(f.name) : f.dyn];
+            c.ns += double(total - f.child);
+            c.calls += 1;
+            c.units += f.units;
+            if (!T.stack.empty())
+                T.stack.back().child += total;
+        }
+        Scope(const Scope &) = delete;
+        Scope &operator=(const Scope &) = delete;
+    };
+
+    /// one solve: start / end (writes the row of the categories)
+    struct SolveScope
+    {
+        SolveScope()
+        {
+            Timers &T = timers();
+            if (T.on)
+            {
+                T.table.clear();
+                T.stack.clear();
+                T.solve_t0 = cpu_ns();
+            }
+        }
+        ~SolveScope()
+        {
+            Timers &T = timers();
+            if (!T.on)
+                return;
+            json cats = json::object();
+            for (const auto &kv : T.table)
+                cats[kv.first] = {{"ns", kv.second.ns}, {"calls", kv.second.calls}, {"units", kv.second.units}};
+            put({{"t", "cats"}, {"step", ctx().step}, {"total_cpu_ns", cpu_ns() - T.solve_t0}, {"cats", cats}});
+            T.table.clear();
+            T.stack.clear();
+        }
+    };
+} // namespace polysolve::cl
diff -ruN ps_orig/src/polysolve/linear/Solver.cpp ps/src/polysolve/linear/Solver.cpp
--- ps_orig/src/polysolve/linear/Solver.cpp	2026-11-23 11:51:17.898102767 -0500
+++ ps/src/polysolve/linear/Solver.cpp	2026-11-23 12:57:20.230157736 -0500
@@ -288,6 +288,33 @@
                 index = long(static_cast<const int *>(L->Perm)[L->minor]);
                 return true;
             }
+            bool factor_stats(double &flops, double &lnz, double &minor, double &n, double &flops_done, double &perm_minor) const override
+            {
+                const CholAccess &a = static_cast<const CholAccess &>(m_Solver);
+                const cholmod_factor *L = a.fac();
+                if (L == nullptr)
+                    return false;
+                cholmod_common &cm = const_cast<CholAccess &>(a).cholmod();
+                flops = cm.fl;
+                lnz = cm.lnz;
+                minor = double(L->minor);
+                n = double(L->n);
+                flops_done = flops;
+                perm_minor = (L->minor < L->n && L->Perm != nullptr) ? double(static_cast<const int *>(L->Perm)[L->minor]) : -1.0;
+                if (L->minor < L->n)
+                {
+                    flops_done = -1;
+                    if (L->ColCount != nullptr)
+                    {
+                        double s = 0;
+                        const int *cc = static_cast<const int *>(L->ColCount);
+                        for (size_t j = 0; j < size_t(L->minor); ++j)
+                            s += double(cc[j]) * double(cc[j]);
+                        flops_done = s;
+                    }
+                }
+                return true;
+            }
         };
     } // namespace
 #endif
