+    }
+    /// set while PathRunner::run is running: the problem and the number of accepted inner steps
+    struct PathScope
+    {
+        PathScope(Problem &p, const int &inner)
+        {
+            problem() = &p;
+            cl::ctx().inner_ptr = &inner;
+        }
+        ~PathScope()
+        {
+            problem() = nullptr;
+            cl::ctx().inner_ptr = nullptr;
+        }
+    };
